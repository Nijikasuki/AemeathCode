# ─────────────────────────────────────────────────────────────
# AemeathCode 配置示例
#
# 通常不用手写:第一次跑 aemeath 会弹配置向导,之后 `aemeath init` 可重跑。
# 想手写就复制本文件:  cp .env.example .aemeath/.env
#
# 配置按两级读取,项目级覆盖全局:
#   1. 真正的 shell 环境变量        —— 最高,临时覆盖
#   2. 当前目录的 .aemeath/.env     —— 这个项目专用
#   3. ~/.config/aemeath/.env       —— 全局兜底(向导写的就是这里)
#
# 注意:项目级读的是 .aemeath/.env,不是你项目根目录的 .env —— 那个文件里通常有你
# 自己的密钥,而 agent 有 bash 工具、子进程继承环境变量,不该被卷进来。
# .aemeath/ 建出来时自带一张自我忽略的 .gitignore,不怕误提交。
# ─────────────────────────────────────────────────────────────

# ── daemon 监听地址 ──────────────────────────────────────────
AEMEATH_PORT=9999
AEMEATH_HOST=127.0.0.1
AEMEATH_LOG_LEVEL=INFO

# ── LLM 提供商(Anthropic 兼容端点)────────────────────────────
# 兼容任何 Anthropic Messages API 的服务(官方 / DeepSeek / 自建网关等)。
ANTHROPIC_API_KEY=sk-your-api-key-here      # 必填
AEMEATH_LLM_DEFAULT_MODEL=your-model-name   # 必填
ANTHROPIC_BASE_URL=https://api.your-provider.com   # 可选;不设 = 官方 api.anthropic.com
                                                   # ⚠️ 别设成空串,那会被当"显式指定了空地址"

# ── Agent 运行参数(都有默认值,可以整节删掉)──────────────────
AEMEATH_MAX_STEPS=25            # ReAct 循环单个 run 的最大步数(默认 25)
AEMEATH_SHOW_THINKING=true      # 是否在前端展示模型思考过程

# ── MCP:连接 GitHub 官方 MCP server 时需要(可选)────────────
# 子进程会继承此 env;不用 GitHub MCP 可留空。
GITHUB_PERSONAL_ACCESS_TOKEN=

# ── 上下文压缩参数(可选,不设走代码默认)────────────────────
# 想手动逼出压缩来观察时才设置,需满足:keep + output + safety < window。
# 改完两个进程(core / tui)都要重启。
# AEMEATH_CONTEXT_WINDOW=16000
# AEMEATH_OUTPUT_BUDGET=2000
# AEMEATH_KEEP_BUDGET=4000
